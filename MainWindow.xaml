<Window x:Class="Limelight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindowRoot"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Limelight.Views"
        Title="Limelight - Dead as Disco Mod Manager"
        Icon="Assets/Limelight.ico"
        Width="1220"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="MainWindow_StateChanged"
        AllowDrop="True"
        PreviewDragEnter="MainWindow_PreviewDragEnter"
        PreviewDragOver="MainWindow_PreviewDragOver"
        PreviewDragLeave="MainWindow_PreviewDragLeave"
        PreviewDrop="MainWindow_PreviewDrop"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.18"
                                     EasingFunction="{StaticResource LimelightEaseOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarSurface"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TitleBarSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.08"
                                                             Duration="0:0:0.10"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>

                                            <DoubleAnimation Storyboard.TargetName="TitleBarSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.08"
                                                             Duration="0:0:0.10"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TitleBarSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.13"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>

                                            <DoubleAnimation Storyboard.TargetName="TitleBarSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.13"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#252943"/>
                    <Setter Property="Foreground"
                            Value="{StaticResource TextBrush}"/>
                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource PinkBrush}"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowVisualRoot"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowVisualScale"
                            ScaleX="1"
                            ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Limelight owns the window chrome so the frame stays on-theme. -->
        <Border Grid.Row="0"
                Panel.ZIndex="500"
                Background="#0C0E1D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                    <TextBlock Text="◆"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource PinkBrush}"/>

                    <TextBlock Text="LIMELIGHT"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Black"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="  /  DEAD AS DISCO MOD MANAGER"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CyanBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="CheckForUpdatesButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Width="116"
                            FontSize="9"
                            FontWeight="SemiBold"
                            ToolTip="Check for Limelight updates"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CheckForUpdates_Click">
                        <TextBlock Text="CHECK UPDATE"
                                   Foreground="{StaticResource CyanBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="11"/>
                    </Button>

                    <Button x:Name="WhatsNewButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Width="98"
                            FontSize="9"
                            FontWeight="SemiBold"
                            ToolTip="Open the latest Limelight release notes"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ShowWhatsNewButton_Click">
                        <TextBlock Text="WHAT'S NEW?"
                                   Foreground="{StaticResource CyanBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="11"/>
                    </Button>

                    <Button Style="{StaticResource TitleBarButtonStyle}"
                             ToolTip="Minimise"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Click="MinimiseWindow_Click">

                        <Path Width="12"
                              Height="1"
                              Data="M 0,0 L 12,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.4"/>
                    </Button>

                    <Button ToolTip="Maximise"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Click="ToggleMaximiseWindow_Click">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource TitleBarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="Maximized">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Path Width="11"
                              Height="11"
                              Data="M 0.7,0.7 L 10.3,0.7 L 10.3,10.3 L 0.7,10.3 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.2"/>
                    </Button>

                    <Button ToolTip="Restore"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Click="ToggleMaximiseWindow_Click">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource TitleBarButtonStyle}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="Maximized">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Path Width="12"
                              Height="12"
                              Data="M 3,0.7 L 11.3,0.7 L 11.3,9 L 9.4,9 M 0.7,3 L 9,3 L 9,11.3 L 0.7,11.3 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.2"/>
                    </Button>

                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                             ToolTip="Close"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Click="CloseWindow_Click">

                        <Path Width="11"
                              Height="11"
                              Data="M 0.8,0.8 L 10.2,10.2 M 10.2,0.8 L 0.8,10.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ApplicationContentRoot"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Limelight branding -->
                    <StackPanel Margin="26,30,20,34">
                        <TextBlock Text="LIMELIGHT"
                               FontSize="27"
                               FontWeight="Black"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextBrush}"/>

                        <Rectangle Width="68"
                               Height="3"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>

                        <TextBlock Text="DEAD AS DISCO MOD MANAGER"
                               Margin="0,10,0,0"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CyanBrush}"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1">

                        <Border x:Name="DashboardNavigation"
            Style="{StaticResource SidebarNavigationItemStyle}"
            Margin="8,3"
            Background="#25203B"
            CornerRadius="8"
            BorderBrush="{StaticResource PinkBrush}"
            BorderThickness="3,0,0,0"
            MouseLeftButtonDown="ShowDashboard_Click"
            MouseEnter="Navigation_MouseEnter"
            MouseLeave="Navigation_MouseLeave"
            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                    Orientation="Horizontal">

                                <TextBlock x:Name="DashboardNavigationIcon"
                                       Text="◆"
                                       Width="26"
                                       FontSize="13"
                                       Foreground="{StaticResource PinkBrush}"/>

                                <TextBlock x:Name="DashboardNavigationText"
                                       Text="Dashboard"
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MyModsNavigation"
            Style="{StaticResource SidebarNavigationItemStyle}"
            Margin="8,3"
            Background="Transparent"
            CornerRadius="8"
            BorderBrush="Transparent"
            BorderThickness="3,0,0,0"
            MouseLeftButtonDown="ShowMyMods_Click"
            MouseEnter="Navigation_MouseEnter"
            MouseLeave="Navigation_MouseLeave"
            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                    Orientation="Horizontal">

                                <TextBlock x:Name="MyModsNavigationIcon"
                                       Text="◇"
                                       Width="26"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="MyModsNavigationText"
                                       Text="My Mods"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="StagehandScriptsNavigation"
                                Style="{StaticResource SidebarNavigationItemStyle}"
                                Margin="8,3"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                MouseLeftButtonDown="ShowStagehandScripts_Click"
                                MouseEnter="Navigation_MouseEnter"
                                MouseLeave="Navigation_MouseLeave"
                                Cursor="Hand">
                            <StackPanel Margin="16,13" Orientation="Horizontal">
                                <TextBlock x:Name="StagehandScriptsNavigationIcon"
                                           Text="◇" Width="26" FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="StagehandScriptsNavigationText"
                                           Text="Stagehand Scripts" FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProfilesNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowProfiles_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                        Orientation="Horizontal">

                                <TextBlock x:Name="ProfilesNavigationIcon"
                                           Text="◇"
                                           Width="26"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="ProfilesNavigationText"
                                           Text="Profiles"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LiveLoadersNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowLiveLoaders_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                        Orientation="Horizontal">

                                <TextBlock x:Name="LiveLoadersNavigationIcon"
                                           Text="◇"
                                           Width="26"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="LiveLoadersNavigationText"
                                           Text="Live Loaders"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MultiplayerNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowMultiplayer_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                        Orientation="Horizontal">

                                <TextBlock x:Name="MultiplayerNavigationIcon"
                                           Text="◇"
                                           Width="26"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="MultiplayerNavigationText"
                                           Text="Multiplayer"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock Text="  EXP"
                                           VerticalAlignment="Center"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#FFD477"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BrowseNexusNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowBrowseNexus_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                    Orientation="Horizontal">

                                <TextBlock x:Name="BrowseNexusNavigationIcon"
                                       Text="◇"
                                       Width="26"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="BrowseNexusNavigationText"
                                       Text="Browse Nexus"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DownloadsNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowDownloads_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                        Orientation="Horizontal">

                                <TextBlock x:Name="DownloadsNavigationIcon"
                                           Text="◇"
                                           Width="26"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="DownloadsNavigationText"
                                           Text="Downloads"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsNavigation"
                            Style="{StaticResource SidebarNavigationItemStyle}"
                            Margin="8,3"
                            Background="Transparent"
                            CornerRadius="8"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            MouseLeftButtonDown="ShowSettings_Click"
                            MouseEnter="Navigation_MouseEnter"
                            MouseLeave="Navigation_MouseLeave"
                            Cursor="Hand">

                            <StackPanel Margin="16,13"
                                    Orientation="Horizontal">

                                <TextBlock x:Name="SettingsNavigationIcon"
                                       Text="◇"
                                       Width="26"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="SettingsNavigationText"
                                       Text="Settings"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Game connection status -->
                    <Border x:Name="GameConnectionCard"
                        Grid.Row="2"
                        Margin="16,16,16,22"
                        Padding="14"
                        Background="#111425"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">

                                <Ellipse x:Name="GameStatusDot"
                                     Width="8"
                                     Height="8"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource PinkBrush}"/>

                                <TextBlock x:Name="GameStatusTitle"
                                       Text="GAME NOT CONNECTED"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock x:Name="GameStatusDescription"
                                   Text="LIMELIGHT EARLY ACCESS&#x0a;MADE BY HENREH &lt;3"
                                   Margin="17,7,0,0"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dashboard page -->
            <Grid x:Name="DashboardPage"
              Style="{StaticResource PageTransitionStyle}"
              Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dashboard header -->
                <Grid Margin="34,24,34,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="DASHBOARD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                        <TextBlock Text="YOUR MODS. YOUR STAGE."
                               Margin="0,4,0,0"
                               FontSize="25"
                               FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                        <Button x:Name="ImportModButton"
                            Content="IMPORT MOD"
                            Click="ImportMod_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"/>

                        <Button x:Name="LaunchGameButton"
                            Content="LAUNCH GAME"
                            Click="LaunchGame_Click"
                            Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="34,0,34,34">

                        <!-- Main spotlight panel -->
                        <Border Padding="30"
                            Style="{StaticResource AnimatedCardStyle}"
                            CornerRadius="14"
                            BorderBrush="#413568"
                            BorderThickness="1">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                    <GradientStop Color="#261531"
                                              Offset="0"/>

                                    <GradientStop Color="#141832"
                                              Offset="0.52"/>

                                    <GradientStop Color="#102D35"
                                              Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel MaxWidth="580"
                                        HorizontalAlignment="Left">

                                    <TextBlock x:Name="SpotlightTitleText"
                                           Text="READY FOR THE SPOTLIGHT?"
                                           FontSize="28"
                                           FontWeight="Black"
                                           TextTrimming="CharacterEllipsis"/>

                                    <TextBlock x:Name="SpotlightDescriptionText"
                                           Text="Connect your game directory, install a character mod, and take control of the stage."
                                           Margin="0,10,0,20"
                                           FontSize="14"
                                           LineHeight="21"
                                           TextWrapping="Wrap"
                                           Foreground="#C8C6D8"/>

                                    <StackPanel Orientation="Horizontal">

                                        <Button x:Name="ConnectGameButton"
                                            Content="CONNECT GAME"
                                            Click="ConnectGame_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                        <Button Content="BROWSE NEXUS"
                                            Margin="10,0,0,0"
                                            Click="BrowseNexus_Click"
                                            Style="{StaticResource SecondaryButton}"/>

                                        <Button Content="DOCUMENTATION"
                                            Margin="10,0,0,0"
                                            Click="DocumentationButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Temporary Limelight artwork -->
                                <Border Grid.Column="1"
                                    Width="150"
                                    Height="150"
                                    Margin="30,0,0,0"
                                    Background="#18FFFFFF"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="75">

                                    <Grid>
                                        <Ellipse Margin="20"
                                             Stroke="{StaticResource PinkBrush}"
                                             StrokeThickness="3"/>

                                        <TextBlock Text="L"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="64"
                                               FontWeight="Black"
                                               FontStyle="Italic"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Dashboard statistics -->
                        <UniformGrid Columns="3"
                                 Margin="0,18,0,12">

                            <Border Margin="0,0,7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                                <StackPanel>
                                    <TextBlock Text="ACTIVE MODEL"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="ActiveModelText"
                       Text="NONE"
                       Margin="0,8,0,0"
                       FontSize="22"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                                <StackPanel>
                                    <TextBlock Text="INSTALLED MODS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="InstalledModCountText"
                       Text="0"
                       Margin="0,8,0,0"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                                <StackPanel>
                                    <TextBlock Text="GAME STATUS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="GameProcessStatusText"
                       Text="NOT RUNNING"
                       Margin="0,8,0,0"
                       FontSize="18"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- The Live Loader deserves enough room to explain what its status means. -->
                        <Border Margin="0,0,0,18"
                            Style="{StaticResource AnimatedCardStyle}"
                            Padding="22"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                    Height="48"
                                    Background="#252943"
                                    CornerRadius="9">

                                    <Grid>
                                        <Ellipse x:Name="LiveLoaderStatusRing"
                                             Margin="7"
                                             Stroke="{StaticResource PinkBrush}"
                                             StrokeThickness="2"/>

                                        <Ellipse x:Name="LiveLoaderStatusDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{StaticResource PinkBrush}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                        Margin="14,0,20,0"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="LIVE LOADER"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="LiveLoaderStatusText"
                                           Text="NOT INSTALLED"
                                           Margin="0,5,0,0"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PinkBrush}"/>

                                    <TextBlock x:Name="LiveLoaderStatusDescriptionText"
                                           Text="Set up the Live Loader to switch character mods without restarting the game."
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                    Padding="13,8"
                                    VerticalAlignment="Center"
                                    Background="#1A1E35"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <TextBlock Text="AUTOMATIC"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Library summary -->
                        <Border Padding="26"
                            Style="{StaticResource AnimatedCardStyle}"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="RECENTLY INSTALLED"
                                           FontSize="13"
                                           FontWeight="Bold"/>

                                    <TextBlock x:Name="LibrarySummaryText"
                                           Text="Your mod library is empty. Import or drag in a ZIP, RAR, or 7Z archive to get started."
                                           Margin="0,10,20,0"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="LibraryStatusText"
                                       Grid.Column="1"
                                       Text="NO MODS YET"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- My Mods occupies the same content area as the dashboard. -->
            <views:MyModsPage x:Name="MyModsPageControl"
                          Style="{StaticResource PageTransitionStyle}"
                          Grid.Column="1"
                           Visibility="Collapsed"/>

            <views:StagehandScriptsPage x:Name="StagehandScriptsPageControl"
                                        Style="{StaticResource PageTransitionStyle}"
                                        Grid.Column="1"
                                        Visibility="Collapsed"/>

            <!-- Profiles keep reusable casts separate from the active mod and X19 rotation. -->
            <views:ProfilesPage x:Name="ProfilesPageControl"
                                Style="{StaticResource PageTransitionStyle}"
                                Grid.Column="1"
                                Visibility="Collapsed"/>

            <!-- Loader modes and the X19 rotation share one focused workspace. -->
            <views:LiveLoadersPage x:Name="LiveLoadersPageControl"
                                   Style="{StaticResource PageTransitionStyle}"
                                   Grid.Column="1"
                                   Visibility="Collapsed"/>

            <!-- Experimental online co-op owns its payload and relay separately from Live Loader modes. -->
            <views:MultiplayerPage x:Name="MultiplayerPageControl"
                                   Style="{StaticResource PageTransitionStyle}"
                                   Grid.Column="1"
                                   Visibility="Collapsed"/>

            <!-- Nexus browsing has its own page so downloading does not crowd the dashboard. -->
            <views:BrowseNexusPage x:Name="BrowseNexusPageControl"
                               Style="{StaticResource PageTransitionStyle}"
                               Grid.Column="1"
                               Visibility="Collapsed"/>

            <!-- Active Nexus transfers and their recent results remain visible here. -->
            <views:DownloadsPage x:Name="DownloadsPageControl"
                                 Style="{StaticResource PageTransitionStyle}"
                                 Grid.Column="1"
                                 Visibility="Collapsed"/>

            <!-- Recovery and diagnostics live here so the dashboard stays simple. -->
            <views:SettingsPage x:Name="SettingsPageControl"
                            Style="{StaticResource PageTransitionStyle}"
                            Grid.Column="1"
                            Visibility="Collapsed"/>

            <!-- Unsafe level transitions use a proper modal layer so another
             activation cannot be started behind a short notification. -->
            <Border x:Name="LevelTransitionBlocker"
                Grid.ColumnSpan="2"
                Panel.ZIndex="200"
                Background="#D900020C"
                Visibility="Collapsed">

                <Border Width="520"
                    Style="{StaticResource AnimatedDialogCardStyle}"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#252943"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="9">

                            <TextBlock Text="◆"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   Foreground="{StaticResource PinkBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LEVEL CHANGE IN PROGRESS"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                            <TextBlock x:Name="LevelTransitionBlockerMessage"
                                   Margin="0,10,0,0"
                                   Text="Dead as Disco is replacing the current level. Live mod switching is locked until the new level is ready."
                                   FontSize="13"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>

                            <Border Margin="0,18,0,0"
                                Padding="13,10"
                                Background="#101426"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                                <TextBlock Text="Your current mod remains active and no files have been changed."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            </Border>

                            <Button Content="OK, I'LL WAIT"
                                Width="150"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                Click="CloseLevelTransitionBlocker_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Timed feedback stays inside Limelight as a quick popup-like overlay. -->
            <Grid x:Name="NotificationPopup"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"
                  Panel.ZIndex="800">

                <Border x:Name="NotificationToast"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Width="620"
                        MaxWidth="620"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A1E35"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Opacity="0"
                        Visibility="Visible"
                        IsHitTestVisible="False">

                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NotificationToastTransform"
                                        Y="10"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NotificationToastAccent"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="9,0,0,9"/>

                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                Margin="16,15,13,15"
                                Background="#252943"
                                CornerRadius="8">

                            <TextBlock x:Name="NotificationToastIcon"
                                       Text="◆"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{StaticResource CyanBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Margin="0,15,20,15"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="NotificationToastTitle"
                                       Text="MOD ACTIVE"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>

                            <TextBlock x:Name="NotificationToastMessage"
                                       Text="The selected mod is now active."
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- The first-run tour stays inside the main window so each step
                 can open the real page and point at the feature being explained. -->
            <Grid x:Name="TutorialOverlay"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="450"
                  Background="#D900020C"
                  Visibility="Collapsed">

                <Canvas x:Name="TutorialSpotlightCanvas"
                        IsHitTestVisible="False">

                    <Border x:Name="TutorialSpotlight"
                            Background="#0FFFFFFF"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="2"
                            CornerRadius="10">

                        <Border.Effect>
                            <DropShadowEffect Color="#FF2FA5"
                                              BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>
                        </Border.Effect>
                    </Border>
                </Canvas>

                <Border x:Name="TutorialCard"
                        Width="500"
                        Margin="34"
                        Padding="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#171B31"
                        BorderBrush="#413568"
                        BorderThickness="1"
                        CornerRadius="13">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="◆"
                                           Margin="0,0,10,0"
                                           FontSize="11"
                                           Foreground="{StaticResource PinkBrush}"/>

                                <TextBlock x:Name="TutorialEyebrowText"
                                           Text="WELCOME TO LIMELIGHT"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="TutorialStepCounterText"
                                       Grid.Column="1"
                                       Text="1 OF 9"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </Grid>

                        <TextBlock x:Name="TutorialTitleText"
                                   Text="YOUR MODS. YOUR STAGE."
                                   Margin="0,14,0,0"
                                   FontSize="25"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>

                        <Rectangle Width="74"
                                   Height="3"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="TutorialDescriptionText"
                                   Margin="0,18,0,0"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="#C8C6D8"/>

                        <Border Margin="0,20,0,0"
                                Padding="13,11"
                                Background="#101426"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <TextBlock x:Name="TutorialHintText"
                                       FontSize="11"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="TutorialSkipButton"
                                    Content="SKIP TOUR"
                                    Padding="16,10"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="TutorialSkip_Click"/>

                            <Button x:Name="TutorialPreviousButton"
                                    Grid.Column="2"
                                    Content="PREVIOUS"
                                    Margin="0,0,10,0"
                                    Padding="16,10"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="TutorialPrevious_Click"/>

                            <Button x:Name="TutorialNextButton"
                                    Grid.Column="3"
                                    Content="NEXT"
                                    Padding="20,10"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="TutorialNext_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- A full-window cue makes it clear that the archive can be dropped
             anywhere instead of forcing the user to find a tiny target. -->
        <Grid x:Name="ModDropOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="700"
              Background="#EC080912"
              IsHitTestVisible="False"
              Visibility="Collapsed">

            <Border Width="570"
                    Padding="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#171B31"
                    BorderBrush="{StaticResource CyanBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Style="{StaticResource AnimatedDialogCardStyle}">

                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="112"
                          Height="112">
                        <Ellipse Stroke="{StaticResource CyanBrush}"
                                 StrokeThickness="2"/>
                        <Ellipse Margin="14"
                                 Stroke="{StaticResource PinkBrush}"
                                 StrokeThickness="4"/>
                        <TextBlock Text="L"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="46"
                                   FontStyle="Italic"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Grid>

                    <TextBlock Text="DROP TO IMPORT"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="ADD MODS TO THE LINEUP"
                               Margin="0,9,0,0"
                               HorizontalAlignment="Center"
                               FontSize="27"
                               FontWeight="Black"
                               Foreground="{StaticResource TextBrush}"/>

                    <Rectangle Width="84"
                               Height="4"
                               Margin="0,17,0,0"
                               Fill="{StaticResource PinkBrush}"/>

                    <TextBlock MaxWidth="450"
                               Margin="0,19,0,0"
                               HorizontalAlignment="Center"
                               Text="Release your ZIP, RAR, or 7Z archive anywhere in this window. Limelight will validate it before anything enters your library."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="#C8C6D8"/>

                    <Border Margin="0,23,0,0"
                            Padding="14,8"
                            HorizontalAlignment="Center"
                            Background="#101426"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Text="◆  ZIP · RAR · 7Z ARCHIVES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ModImportProgressOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="710"
                Width="360"
                Margin="0,0,24,24"
                Padding="18,15"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#F2171B31"
                BorderBrush="{StaticResource CyanBrush}"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="IMPORTING MOD"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock x:Name="ModImportProgressText"
                           Margin="0,6,0,10"
                           Text="READING ARCHIVE..."
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Background="#252A43"
                             BorderThickness="0"
                             Foreground="{StaticResource PinkBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
