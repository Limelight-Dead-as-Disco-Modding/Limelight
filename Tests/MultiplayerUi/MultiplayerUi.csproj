<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LimelightAssemblyPath Condition="'$(LimelightAssemblyPath)' == ''">..\..\bin\Release\net8.0-windows\Limelight.dll</LimelightAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Limelight">
      <HintPath>$(LimelightAssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
