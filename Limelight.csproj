<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Limelight.ico</ApplicationIcon>
    <Version>0.2.0-early-access</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-early-access</InformationalVersion>
    <!-- CUE4Parse keeps its native helper in the same NuGet folder as the
         managed assembly. MSBuild may inspect that helper as managed code;
         the resulting notice is harmless because it is loaded natively. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3246</MSBuildWarningsAsMessages>
    <Configurations>Debug;Release;Test</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Limelight.ico" />

    <PackageReference Include="CUE4Parse" Version="1.2.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.6.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.7.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.8.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.9.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.10.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.13.dll" />
    <None Remove="Payloads\NativeBridge\bridge-manifest.json" />

    <EmbeddedResource Include="Payloads\NativeBridge\LimelightNativeBridge-0.1.13.dll" LogicalName="Limelight.Payloads.NativeBridge.LimelightNativeBridge.dll" />

    <EmbeddedResource Include="Payloads\NativeBridge\bridge-manifest.json" LogicalName="Limelight.Payloads.NativeBridge.bridge-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\Multiplayer\host.lua" />
    <None Remove="Payloads\Multiplayer\client.lua" />
    <None Remove="Payloads\Multiplayer\LimelightMPNative.dll" />
    <None Remove="Payloads\Multiplayer\LimelightMPRelay.exe" />
    <None Remove="Payloads\Multiplayer\multiplayer-manifest.json" />

    <EmbeddedResource Include="Payloads\Multiplayer\host.lua" LogicalName="Limelight.Payloads.Multiplayer.host.lua" />
    <EmbeddedResource Include="Payloads\Multiplayer\client.lua" LogicalName="Limelight.Payloads.Multiplayer.client.lua" />
    <EmbeddedResource Include="Payloads\Multiplayer\LimelightMPNative.dll" LogicalName="Limelight.Payloads.Multiplayer.LimelightMPNative.dll" />
    <EmbeddedResource Include="Payloads\Multiplayer\LimelightMPRelay.exe" LogicalName="Limelight.Payloads.Multiplayer.LimelightMPRelay.exe" />
    <EmbeddedResource Include="Payloads\Multiplayer\multiplayer-manifest.json" LogicalName="Limelight.Payloads.Multiplayer.multiplayer-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\UE4SS\UE4SS.dll" />
    <EmbeddedResource Include="Payloads\UE4SS\UE4SS.dll" LogicalName="Limelight.Payloads.UE4SS.UE4SS.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\Stagehand\stagehand-payload-manifest.json" />
    <None Remove="Payloads\Stagehand\LimelightStagehand.zip" />

    <EmbeddedResource Include="Payloads\Stagehand\stagehand-payload-manifest.json" LogicalName="Limelight.Payloads.Stagehand.stagehand-payload-manifest.json" />
    <EmbeddedResource Include="Payloads\Stagehand\LimelightStagehand.zip" LogicalName="Limelight.Payloads.Stagehand.LimelightStagehand.zip" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\CharacterLoader\LimelightCharacterLoader.pak" />
    <None Remove="Payloads\CharacterLoader\LimelightCharacterLoader.utoc" />
    <None Remove="Payloads\CharacterLoader\LimelightCharacterLoader.ucas" />

    <EmbeddedResource Include="Payloads\CharacterLoader\LimelightCharacterLoader.pak" LogicalName="Limelight.Payloads.CharacterLoader.LimelightCharacterLoader.pak" />
    <EmbeddedResource Include="Payloads\CharacterLoader\LimelightCharacterLoader.utoc" LogicalName="Limelight.Payloads.CharacterLoader.LimelightCharacterLoader.utoc" />
    <EmbeddedResource Include="Payloads\CharacterLoader\LimelightCharacterLoader.ucas" LogicalName="Limelight.Payloads.CharacterLoader.LimelightCharacterLoader.ucas" />
  </ItemGroup>

</Project>
