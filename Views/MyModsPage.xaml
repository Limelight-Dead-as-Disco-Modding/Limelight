<UserControl x:Class="Limelight.Views.MyModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <UserControl.Resources>
        <DataTemplate x:Key="ModCardTemplate">
            <Border Margin="0,0,0,12"
                    Padding="20"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="46"
                            Height="46"
                            Background="#28213F"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Text="◆"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <Border Margin="10,0,0,0"
                                    Padding="8,3"
                                    Background="#151B31"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Text="{Binding LibraryCategoryLabel}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ReplacementTargetLabel}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <StackPanel Margin="0,6,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Text="{Binding PackageFiles.Count, StringFormat={}{0} package files}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock Text="  •  "
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock Text="{Binding InstalledAt, StringFormat={}Imported {0:dd MMM yyyy}}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Tag="{Binding Id}"
                                Click="ToggleMod_Click"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content"
                                            Value="ACTIVATE"/>
                                    <Setter Property="MinWidth"
                                            Value="105"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConventionalMod}"
                                                     Value="True">
                                            <Setter Property="Content"
                                                    Value="ENABLE"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsArenaSlotMod}"
                                                     Value="True">
                                            <Setter Property="Content"
                                                    Value="SUPPORTED"/>
                                            <Setter Property="IsEnabled"
                                                    Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsActive}"
                                                     Value="True">
                                            <Setter Property="Content"
                                                    Value="DEACTIVATE"/>
                                            <Setter Property="Background"
                                                    Value="{StaticResource CyanBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="#090B17"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsEnabledForNextLaunch}"
                                                     Value="True">
                                            <Setter Property="Content"
                                                    Value="DISABLE"/>
                                            <Setter Property="Background"
                                                    Value="{StaticResource CyanBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="#090B17"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="RENAME"
                                Tag="{Binding Id}"
                                Click="RenameMod_Click"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button Content="REMOVE"
                                Tag="{Binding Id}"
                                Click="RemoveMod_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MY MODS"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock Text="YOUR MOD LIBRARY"
                           Margin="0,5,0,0"
                           FontSize="27"
                           FontWeight="Bold"/>

                <TextBlock Text="Live-switch characters or build a stack of replacements for your next launch."
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="14,8"
                    VerticalAlignment="Top"
                    Background="#1A1E35"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="5,18,-5,0">
                <TextBlock x:Name="ModCountText"
                           Text="0 MODS"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource PinkBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="6"
                HorizontalAlignment="Left"
                Background="#101426"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CharactersTabButton"
                        Content="CHARACTERS (0)"
                        Click="CharactersTab_Click"
                        MinWidth="150"
                        Style="{StaticResource SecondaryButton}"/>

                <Button x:Name="OtherModsTabButton"
                        Content="OTHER REPLACEMENTS (0)"
                        Click="OtherModsTab_Click"
                        Margin="6,0,0,0"
                        MinWidth="205"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid x:Name="CharactersPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Charlie replacements and Character Slot mods can use Limelight's live-switching tools."
                           Margin="2,0,0,12"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyCharactersText"
                               Text="There are no character mods to display."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl x:Name="CharacterModsList"
                                      ItemTemplate="{StaticResource ModCardTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="OtherModsPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        Background="#11182A"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="Boss, enemy, and world replacements can be enabled together. Changes apply on the next game launch and do not use Live Loader or X19."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyOtherModsText"
                               Text="There are no other replacements to display."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl x:Name="OtherModsList"
                                      ItemTemplate="{StaticResource ModCardTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="RenameOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="#D9070914">
            <Border Width="520"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource RaisedPanelBrush}"
                    BorderBrush="{StaticResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="RENAME MOD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="GIVE THIS MOD A CLEANER NAME"
                               Margin="0,8,0,0"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <Border Margin="0,20,0,0"
                            Padding="14,4"
                            Background="#0D1020"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="RenameTextBox"
                                 MaxLength="80"
                                 Padding="0,8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{StaticResource CyanBrush}"
                                 Foreground="{StaticResource PinkBrush}"
                                 FontSize="15"
                                 PreviewKeyDown="RenameTextBox_PreviewKeyDown"/>
                    </Border>

                    <TextBlock x:Name="RenameValidationText"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="CANCEL"
                                Click="CancelRename_Click"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button Content="SAVE NAME"
                                Click="SaveRename_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
