<Window x:Class="Limelight.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:Limelight.Animations"
        Width="960"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        motion:WindowMotion.AnimateClose="True">

    <Window.Resources>
        <Style x:Key="ReleaseTitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,13,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource PinkBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource AnimatedDialogCardStyle}"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              Direction="270"
                              Opacity="0.45"
                              ShadowDepth="9"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Background="#0C0E1D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x25C6;"
                                   Margin="0,0,10,0"
                                   FontSize="9"
                                   Foreground="{StaticResource PinkBrush}"/>
                        <TextBlock Text="LIMELIGHT CHANGELOG"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Style="{StaticResource ReleaseTitleBarButtonStyle}"
                            ToolTip="Close">
                        <Path Width="11"
                              Height="11"
                              Data="M 0.8,0.8 L 10.2,10.2 M 10.2,0.8 L 0.8,10.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="36,30,28,30"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Eyebrow}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text="{Binding Title}"
                                       Margin="0,7,0,0"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Rectangle Width="82"
                                       Height="4"
                                       Margin="0,15,0,0"
                                       HorizontalAlignment="Left"
                                       Fill="{StaticResource PinkBrush}"/>
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,17,0,0"
                                       FontSize="14"
                                       LineHeight="22"
                                       TextWrapping="Wrap"
                                       Foreground="#D3D1DF"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="28,0,0,0"
                                Padding="16,12"
                                VerticalAlignment="Top"
                                Background="{StaticResource RaisedPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <TextBlock Text="RELEASE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding Version}"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PinkBrush}"/>
                                <Border Margin="0,10,0,9"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"/>
                                <TextBlock Text="{Binding PublishedLabel}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CHANGELOG"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   Text="{Binding RangeLabel}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>

                    <Border Margin="0,11,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"/>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,23"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,1,24,0">
                                            <Border Padding="10,6"
                                                    HorizontalAlignment="Left"
                                                    Background="#15192C"
                                                    BorderBrush="{Binding Accent}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <TextBlock Text="{Binding Eyebrow}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Accent}"/>
                                            </Border>
                                            <Border Width="3"
                                                    Height="30"
                                                    Margin="11,10,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Accent}"
                                                    CornerRadius="2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="19"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Margin="0,7,0,0"
                                                       FontSize="12"
                                                       LineHeight="19"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>

                                            <ItemsControl Margin="0,10,0,0"
                                                          ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#x25C6;"
                                                                       Margin="1,3,0,0"
                                                                       FontSize="7"
                                                                       Foreground="{StaticResource CyanBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontSize="12"
                                                                       LineHeight="18"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#D3D1DF"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,26,0,0"
                            Padding="22,20"
                            Background="#17111E"
                            BorderBrush="#5A3150"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="KNOWN EARLY ACCESS LIMITS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock Text="The honest part of the changelog."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <ItemsControl Margin="0,14,0,0"
                                          ItemsSource="{Binding KnownIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="!"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PinkBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       FontSize="12"
                                                       LineHeight="18"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D3D1DF"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="26,18"
                    Background="#0C0E1D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <Grid>
                    <TextBlock Margin="4,0,330,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="FULL NOTES, GUIDES, AND COMPATIBILITY DETAILS ARE AVAILABLE IN THE DOCUMENTATION."/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="DocumentationButton"
                                MinWidth="154"
                                Content="READ DOCUMENTATION"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="ContinueButton"
                                MinWidth="146"
                                Margin="10,0,0,0"
                                Content="BACK TO LIMELIGHT"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
