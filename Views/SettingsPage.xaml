<UserControl x:Class="Limelight.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <UserControl.Resources>
        <!-- I keep status colour inside each card so the page structure stays calm and predictable. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>

        <Style x:Key="SettingsCategoryTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="CategorySurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="13"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CategoryMarker"
                                        Width="3"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        CornerRadius="2"/>

                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategorySurface" Property="Background" Value="#191D31"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CategorySurface" Property="Background" Value="#252038"/>
                                <Setter TargetName="CategorySurface" Property="BorderBrush" Value="#46345D"/>
                                <Setter TargetName="CategoryMarker" Property="Background" Value="{StaticResource PinkBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- I keep the categories visible so changing sections never shifts the page around. -->
        <Style x:Key="SettingsCategoryTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#0E1120"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="20,22,20,10">
                                        <TextBlock Text="PREFERENCES"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="SETTINGS"
                                                   Margin="0,5,0,0"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Tune Limelight without digging through long menus."
                                                   Margin="0,8,0,0"
                                                   FontSize="11"
                                                   LineHeight="17"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>

                                    <TabPanel Grid.Row="1"
                                              Margin="12,12,12,4"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"/>

                                    <TextBlock Grid.Row="2"
                                               Text="LIMELIGHT EARLY ACCESS"
                                               Margin="20,12,20,20"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#636B91"/>
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Column="2"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResourceOverlayToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#0D1020"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleTrack"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Ellipse x:Name="ToggleThumb"
                                     Width="22"
                                     Height="22"
                                     Margin="4"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource PinkBrush}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#12313B"/>
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,28,26,0">
        <TabControl x:Name="SettingsCategoryTabs"
                    SelectedIndex="0"
                    Style="{StaticResource SettingsCategoryTabControlStyle}">

            <TabItem Header="GENERAL" Style="{StaticResource SettingsCategoryTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="SETTINGS / GENERAL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text="EVERYDAY PREFERENCES"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Manage the connected game and the small ways Limelight can appear outside its main window."
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="GAME CONNECTION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="GameConnectionStatusText"
                                               Text="NOT CONNECTED"
                                               Margin="0,8,0,0"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                    <TextBlock x:Name="GameConnectionDetailText"
                                               Text="Choose the Dead as Disco installation folder."
                                               Margin="0,7,24,0"
                                               MaxWidth="720"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <Button x:Name="ChangeGameFolderButton"
                                            Content="CHANGE GAME FOLDER"
                                            Margin="0,15,0,0"
                                            HorizontalAlignment="Left"
                                            Click="ChangeGameFolderButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="13,8"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RaisedPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="GameRunningBadgeText"
                                               Text="NOT RUNNING"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="DISCORD ACTIVITY"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="DiscordPresenceStatusText"
                                                   Text="PRIVATE"
                                                   Margin="0,8,0,0"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                        <TextBlock x:Name="DiscordPresenceDetailText"
                                                   Text="Share Limelight and current game activity on your Discord profile."
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>

                                    <Button x:Name="DiscordPresenceButton"
                                            Grid.Row="1"
                                            Content="ENABLE PRESENCE"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            Click="DiscordPresenceButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="RESOURCE DISPLAY"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="ResourceOverlayStatusText"
                                                   Text="DISABLED"
                                                   Margin="0,8,0,0"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                        <TextBlock Text="Show Limelight's compact performance and resource overlay."
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>

                                    <ToggleButton x:Name="ResourceOverlayToggleButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  Checked="ResourceOverlayToggleButton_Changed"
                                                  Unchecked="ResourceOverlayToggleButton_Changed"
                                                  Style="{StaticResource ResourceOverlayToggleStyle}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LIVE LOADER" Style="{StaticResource SettingsCategoryTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="SETTINGS / LIVE LOADER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text="THE CURRENT SHOW"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="Bold"/>
                            <TextBlock Text="A clear view of the active session, mounted containers, and cleanup waiting backstage."
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="LIVE SESSION"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="SessionStatusText"
                                                   Text="IDLE"
                                                   Margin="0,8,0,0"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="13,8"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource RaisedPanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBlock x:Name="MountedContainerText"
                                                   Text="0 MOUNTED • AUTO-RECYCLE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="SessionDetailText"
                                           Text="Start the game to begin a fresh live session."
                                           Margin="0,14,0,0"
                                           FontSize="13"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <Border Margin="0,18,0,0"
                                        Padding="15,12"
                                        Background="#101426"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CLEANUP"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock x:Name="StagingText"
                                                   Grid.Column="1"
                                                   Text="No staged files are waiting for cleanup."
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SUPPORT" Style="{StaticResource SettingsCategoryTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="SETTINGS / SUPPORT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text="RECOVERY AND DIAGNOSTICS"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Check compatibility, prepare useful reports, and repair the parts Limelight manages."
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="GAME COMPATIBILITY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="CompatibilityUpdateTitleText"
                                               Text="CURRENT DEAD AS DISCO UPDATE"
                                               Margin="0,8,0,0"
                                               FontSize="19"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="CompatibilityDetailText"
                                               Text="Compatibility has not been checked yet."
                                               Margin="0,8,28,0"
                                               MaxWidth="760"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <WrapPanel Margin="0,16,0,0">
                                        <Border Margin="0,0,10,8"
                                                Padding="13,9"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="GAME UPDATE"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock x:Name="CompatibilityReleaseDateText"
                                                           Text="DATE UNAVAILABLE"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,0,10,8"
                                                Padding="13,9"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="SUPPORTED BUILD"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock x:Name="CompatibilityBuildDateText"
                                                           Text="DATE UNAVAILABLE"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Expander Margin="0,7,0,0"
                                              HorizontalAlignment="Left"
                                              Background="Transparent"
                                              Foreground="{StaticResource MutedTextBrush}">
                                        <Expander.Header>
                                            <TextBlock Text="SHOW TECHNICAL BUILD DETAILS"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Expander.Header>
                                        <Border MaxWidth="760"
                                                Margin="0,9,0,0"
                                                Padding="12,10"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <TextBlock x:Name="CompatibilityTechnicalText"
                                                       Text="Technical build information is not available yet."
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       LineHeight="19"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </Expander>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="14,8"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RaisedPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="CompatibilityStatusText"
                                               Text="NOT CHECKED"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="REPORTS AND TESTING"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="Package the useful details without exposing personal files."
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Content="CREATE TEST REPORT"
                                                Margin="0,0,10,10"
                                                Click="CreatePrivateTestReportButton_Click"
                                                Style="{StaticResource PrimaryButton}"/>
                                        <Button Content="EXPORT DIAGNOSTICS"
                                                Margin="0,0,10,10"
                                                Click="ExportButton_Click"
                                                Style="{StaticResource SecondaryButton}"/>
                                        <Button x:Name="NativeTestButton"
                                                Content="NATIVE TEST"
                                                Margin="0,0,0,10"
                                                Click="NativeTestButton_Click"
                                                Style="{StaticResource SecondaryButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="REPAIR LIVE LOADER"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="Restore Limelight-managed loader files while the game is closed."
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <Button x:Name="RepairButton"
                                            Content="REPAIR LIVE LOADER"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            Click="RepairButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="22"
                                Background="#1A101C"
                                BorderBrush="#60334F"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="REMOVE DEPLOYED MODS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                    <TextBlock Text="Purge every mod Limelight has placed in the game. Your managed library is not deleted."
                                               Margin="0,7,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="PURGE ALL MODS"
                                        VerticalAlignment="Center"
                                        Click="PurgeAllModsButton_Click"
                                        Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
