<UserControl x:Class="Limelight.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <UserControl.Resources>
        <!-- I keep every settings card on the same visual foundation. Status colours
             belong inside the card, rather than changing the card itself. -->
        <Style x:Key="SettingsCardStyle"
               TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>

        <Style x:Key="SettingsTabItemStyle"
               TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,10,0"
                              ClipToBounds="False">
                            <Border x:Name="TabSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{StaticResource RaisedPanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="TabDiamond"
                                        Width="8"
                                        Height="8"
                                        Margin="1,0,12,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource MutedTextBrush}"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface"
                                        Property="Background"
                                        Value="#1D2138"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface"
                                        Property="Background"
                                        Value="#2A2141"/>
                                <Setter TargetName="TabSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource PinkBrush}"/>
                                <Setter TargetName="TabDiamond"
                                        Property="Background"
                                        Value="{StaticResource PinkBrush}"/>
                                <Setter TargetName="TabDiamond"
                                        Property="BorderBrush"
                                        Value="{StaticResource PinkBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle"
               TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"/>

                            <ContentPresenter Grid.Row="1"
                                              Margin="0,18,0,0"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResourceOverlayToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#0D1020"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleTrack"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Ellipse x:Name="ToggleThumb"
                                     Width="22"
                                     Height="22"
                                     Margin="4"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource PinkBrush}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack"
                                        Property="BorderBrush"
                                        Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack"
                                        Property="Background"
                                        Value="#12313B"/>
                                <Setter TargetName="ToggleTrack"
                                        Property="BorderBrush"
                                        Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="ToggleThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="ToggleThumb"
                                        Property="Fill"
                                        Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="38,30,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource CyanBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="SETTINGS / GENERAL"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="1">
                                <Setter Property="Text" Value="SETTINGS / LIVE LOADER"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text" Value="SETTINGS / NEXUS MODS"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text" Value="SETTINGS / SUPPORT"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="0,5,0,0"
                       FontSize="27"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="EVERYDAY PREFERENCES"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="1">
                                <Setter Property="Text" Value="CONTROL THE LIVE SHOW"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text" Value="CONNECT TO THE CATALOGUE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text" Value="RECOVERY AND DIAGNOSTICS"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="Manage the connected game, Discord activity, and Limelight's optional resource display."/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="1">
                                <Setter Property="Text"
                                        Value="Configure X19 rotation controls and keep an eye on the current live session."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text"
                                        Value="Manage Nexus testing access, account details, catalogue limits, and request activity."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabs}"
                                         Value="2">
                                <Setter Property="Text"
                                        Value="Repair managed loader files, verify the native bridge, or prepare a private diagnostic report."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TabControl x:Name="SettingsCategoryTabs"
                    Grid.Row="1"
                    Margin="0,24,0,0"
                    SelectedIndex="0"
                    Style="{StaticResource SettingsTabControlStyle}">

            <!-- General keeps the everyday choices together. -->
            <TabItem Header="GENERAL"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="GAME CONNECTION"
                                               FontSize="12"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="GameConnectionStatusText"
                                               Text="NOT CONNECTED"
                                               Margin="0,10,0,0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>

                                    <TextBlock x:Name="GameConnectionDetailText"
                                               Text="Choose the Dead as Disco installation folder."
                                               Margin="0,7,20,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <Button x:Name="ChangeGameFolderButton"
                                            Content="CHANGE GAME FOLDER"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            Click="ChangeGameFolderButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="13,8"
                                        VerticalAlignment="Top"
                                        Background="#1A1E35"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="GameRunningBadgeText"
                                               Text="NOT RUNNING"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Rich Presence is opt-in because Discord activity is visible to other people. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISCORD RICH PRESENCE"
                                               FontSize="12"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="DiscordPresenceStatusText"
                                               Text="PRIVATE"
                                               Margin="0,10,0,0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>

                                    <TextBlock x:Name="DiscordPresenceDetailText"
                                               Text="Enable this to share Limelight, game, active-mod, X19, and multiplayer activity on your Discord profile."
                                               Margin="0,7,24,0"
                                               MaxWidth="720"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <Button x:Name="DiscordPresenceButton"
                                        Grid.Column="1"
                                        Content="ENABLE PRESENCE"
                                        MinWidth="156"
                                        VerticalAlignment="Center"
                                        Click="DiscordPresenceButton_Click"
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="RESOURCE OVERLAY"
                                               FontSize="12"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="ResourceOverlayStatusText"
                                               Text="DISABLED"
                                               Margin="0,10,0,0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>

                                    <TextBlock Text="Show a small, translucent Limelight panel with this application's current memory usage. It is disabled by default and never displays data from other applications."
                                               Margin="0,7,24,0"
                                               MaxWidth="760"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="24,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <ToggleButton x:Name="ResourceOverlayToggleButton"
                                                  IsChecked="False"
                                                  Checked="ResourceOverlayToggleButton_Changed"
                                                  Unchecked="ResourceOverlayToggleButton_Changed"
                                                  Style="{StaticResource ResourceOverlayToggleStyle}"/>
                                    <TextBlock Text="OFF BY DEFAULT"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LIVE LOADER"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="LIVE SESSION"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="SessionStatusText"
                                                   Text="IDLE"
                                                   Margin="0,10,0,0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="13,8"
                                            VerticalAlignment="Top"
                                            Background="#1A1E35"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBlock x:Name="MountedContainerText"
                                                   Text="0 MOUNTED • AUTO-RECYCLE"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="SessionDetailText"
                                           Text="Start the game to begin a live session."
                                           Margin="0,10,0,0"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="StagingText"
                                           Text="No staged files are waiting for cleanup."
                                           Margin="0,7,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SUPPORT"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PageTransitionStyle}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,12,30">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="LOCAL COMPATIBILITY"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>

                                    <TextBlock x:Name="CompatibilityUpdateTitleText"
                                               Text="CURRENT DEAD AS DISCO UPDATE"
                                               Margin="0,9,0,0"
                                               FontSize="22"
                                               FontWeight="ExtraBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="CompatibilityDetailText"
                                               Text="Connect Dead as Disco to check Live Loader readiness."
                                               MaxWidth="720"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Left"
                                               FontSize="13"
                                               LineHeight="21"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <WrapPanel Margin="0,18,0,0">
                                        <Border Margin="0,0,10,8"
                                                Padding="12,8"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="UPDATE RELEASED"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>

                                                <TextBlock x:Name="CompatibilityReleaseDateText"
                                                           Text="DATE UNAVAILABLE"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,0,10,8"
                                                Padding="12,8"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="SUPPORTED BUILD PUBLISHED"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>

                                                <TextBlock x:Name="CompatibilityBuildDateText"
                                                           Text="DATE UNAVAILABLE"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Expander Margin="0,7,0,0"
                                              HorizontalAlignment="Left"
                                              Background="Transparent"
                                              Foreground="{StaticResource MutedTextBrush}">
                                        <Expander.Header>
                                            <TextBlock Text="SHOW TECHNICAL BUILD DETAILS"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Expander.Header>

                                        <Border MaxWidth="760"
                                                Margin="0,9,0,0"
                                                Padding="12,10"
                                                Background="#101426"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <TextBlock x:Name="CompatibilityTechnicalText"
                                                       Text="Technical build information is not available yet."
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       LineHeight="19"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </Expander>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="24,0,0,0"
                                        Padding="14,8"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RaisedPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock x:Name="CompatibilityStatusText"
                                               Text="NOT CHECKED"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="RECOVERY TOOLS"
                                           FontSize="12"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Repair managed loader files, clear every deployed mod from the game, or prepare a private diagnostic report. Recovery actions are only available while the game is closed."
                                           Margin="0,10,0,0"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="CREATE TEST REPORT"
                                            Margin="0,0,12,10"
                                            Click="CreatePrivateTestReportButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button x:Name="RepairButton"
                                            Content="REPAIR LIVE LOADER"
                                            Margin="0,0,12,10"
                                            Click="RepairButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button Content="PURGE ALL MODS"
                                            Margin="0,0,12,10"
                                            Click="PurgeAllModsButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button Content="EXPORT DIAGNOSTIC REPORT"
                                            Margin="0,0,12,10"
                                            Click="ExportButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>

                                    <Button x:Name="NativeTestButton"
                                            Content="NATIVE TEST"
                                            Margin="0,0,0,10"
                                            Click="NativeTestButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

