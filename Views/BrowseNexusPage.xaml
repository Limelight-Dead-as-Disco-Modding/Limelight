<UserControl x:Class="Limelight.Views.BrowseNexusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">
    <Grid Margin="38,30,38,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="BROWSE NEXUS"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>
                <TextBlock Text="THE REAL CATALOGUE, RIGHT INSIDE LIMELIGHT"
                           Margin="0,5,0,0"
                           FontSize="27"
                           FontWeight="Bold"/>
                <TextBlock Text="Sign in on Nexus Mods normally. Supported archives downloaded in this window are handed directly to Limelight's importer."
                           Margin="0,8,0,0"
                           MaxWidth="820"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,7"
                    VerticalAlignment="Top"
                    Background="#132A33"
                    BorderBrush="{StaticResource CyanBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock Text="PRIVATE BROWSER SESSION"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="12"
                        Background="#111427"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="BACK"
                                MinWidth="64"
                                Style="{StaticResource SecondaryButton}"
                                Click="BackButton_Click"/>
                        <Button Grid.Column="1"
                                Content="FORWARD"
                                MinWidth="78"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="ForwardButton_Click"/>
                        <Button Grid.Column="2"
                                Content="REFRESH"
                                MinWidth="74"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="RefreshButton_Click"/>
                        <Button Grid.Column="3"
                                Content="HOME"
                                MinWidth="62"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="HomeButton_Click"/>

                        <TextBox x:Name="NexusAddressBox"
                                 Grid.Column="4"
                                 Height="38"
                                 Margin="12,0,0,0"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 Background="#0B0D18"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource CyanBrush}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 KeyDown="NexusAddressBox_KeyDown"/>
                    </Grid>
                </Border>

                <webview2:WebView2 x:Name="NexusBrowser"
                                   Grid.Row="1"
                                   NavigationStarting="NexusBrowser_NavigationStarting"
                                   NavigationCompleted="NexusBrowser_NavigationCompleted"/>

                <Border x:Name="BrowserUnavailablePanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#F20A0C17">
                    <StackPanel MaxWidth="580"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="THE NEXUS BROWSER COULD NOT START"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="BrowserUnavailableText"
                                   Margin="0,10,0,0"
                                   Text="Install or repair Microsoft Edge WebView2, then reopen Limelight."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DownloadStatusPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Padding="14,11"
                        Background="#111A2B"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DownloadStatusTitle"
                                       Text="NEXUS DOWNLOAD"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="DownloadStatusText"
                                       Margin="0,4,16,0"
                                       Text="Waiting for Nexus Mods."
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <ProgressBar x:Name="DownloadProgressBar"
                                     Grid.Column="1"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="13,10"
                Background="#121528"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="Use Nexus's regular Manual Download flow. Mod Manager Download links use the nxm protocol and cannot be resolved after removing the Nexus API."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </Border>
    </Grid>
</UserControl>
