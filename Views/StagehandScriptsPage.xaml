<UserControl x:Class="Limelight.Views.StagehandScriptsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">
    <Grid Margin="38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="STAGEHAND SCRIPTS" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>
                <TextBlock Text="CONTROL THE LOGIC MODS BEHIND LIMELIGHT"
                           Margin="0,5,0,0" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Review installed Lua scripts, their exact-file approval, requested permissions, runtime log, and launch state."
                           Margin="0,8,0,0" FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="UPDATE STAGEHAND RUNTIME"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="UpdateRuntime_Click"/>
                <Button Content="REFRESH"
                        Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="16"
                Background="#171A2D" BorderBrush="{StaticResource PurpleBrush}"
                BorderThickness="1" CornerRadius="9">
            <StackPanel>
                <TextBlock x:Name="RuntimeHealthText" Text="RUNTIME HEALTH · Not reported yet"
                           FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource CyanBrush}"/>
                <TextBlock Text="Lua is trusted code inside the game process—not a secure sandbox. A local Stagehand approval only proves that the reviewed hashes match the installed files; it does not make unknown code safe. Enable or disable changes apply on the next game launch."
                           Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="EmptyText" Text="NO STAGEHAND SCRIPTS INSTALLED"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ScriptsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,12" Padding="20"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Id}"/><Run Text="  ·  v"/><Run Text="{Binding Version}"/>
                                            <Run Text="  ·  API "/><Run Text="{Binding ApiVersion}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ReviewText}" Margin="0,13,0,0"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PinkBrush}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="Trust label: "/><Run Text="{Binding DeclaredTrust}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PermissionText}" Margin="0,8,0,0"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="{Binding CapabilityText}" Margin="0,6,0,0"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding DependencyText}" Margin="0,4,0,0"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <Border Margin="0,12,0,0" Padding="10" Background="#0D1020" CornerRadius="6">
                                            <TextBlock Text="{Binding RecentLog}" FontFamily="Consolas" FontSize="10"
                                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                        <Button Content="{Binding ToggleText}" CommandParameter="{Binding Id}"
                                                Margin="0,14,0,0" Style="{StaticResource SecondaryButton}"
                                                Click="Toggle_Click"/>
                                        <Button Content="REMOVE" CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding CanRemove}"
                                                ToolTip="{Binding RemoveHint}"
                                                Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                                Click="Remove_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.RowSpan="3"
                Background="#FF090B14"
                BorderBrush="{StaticResource PinkBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/StagehandUnderConstruction.jpg"
                       Stretch="UniformToFill"/>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <GradientStop Offset="0"
                                          Color="#5505070E"/>
                            <GradientStop Offset="0.52"
                                          Color="#9905070E"/>
                            <GradientStop Offset="1"
                                          Color="#F205070E"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel MaxWidth="680"
                            Margin="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Border Padding="12,7"
                            HorizontalAlignment="Center"
                            Background="#E82A1830"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Text="UNDER CONSTRUCTION"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>

                    <TextBlock Text="STAGEHAND IS STILL BUILDING THE SET"
                               Margin="0,16,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="The tools are on the floor and the runtime is not ready for the public show yet. We will uncover this page when Stagehand is safe to use."
                               Margin="0,10,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="19"
                               Foreground="#FFD6DBF6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
